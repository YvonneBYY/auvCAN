#
# Vehicle kill/arm state.
# Publisher: Controller (node 1), 20 Hz and immediately on change, priority 0.
# Receivers MUST treat absence of this message for longer than their
# kill timeout (default 250 ms), or a repeated seq, as killed.
#
# armed = !hard_kill && !soft_kill && host_ok && !node_kill
#
bool armed          # true = actuators may run
bool hard_kill      # hardware kill switch asserted
bool soft_kill      # software kill requested by the host
bool host_ok        # host heartbeat currently present
bool node_kill      # a KillRequest from BMB/Power is in effect (latched if latching is adopted)
void3
uint8 node_kill_src # node ID of the KillRequest that caused node_kill, 0 = none
uint8 seq           # increments every message; lets receivers detect a stuck publisher
